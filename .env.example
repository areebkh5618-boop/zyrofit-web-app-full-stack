# MongoDB ------------------------------------------------------------
# Get a free cluster at https://www.mongodb.com/cloud/atlas
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/zyrofit
MONGODB_URI=

# Auth ----------------------------------------------------------------
# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Stripe ----------------------------------------------------------------
# From https://dashboard.stripe.com/test/apikeys (use TEST keys while developing)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the Stripe CLI or Dashboard > Webhooks, after pointing it at /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# App ----------------------------------------------------------------
# Used to build absolute redirect URLs for Stripe Checkout
NEXT_PUBLIC_BASE_URL=http://localhost:3000
